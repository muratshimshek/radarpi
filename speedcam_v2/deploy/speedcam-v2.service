[Unit]
Description=SpeedCam V2 Live
After=network.target

[Service]
Type=simple
User=radarpi
WorkingDirectory=/home/radarpi/radar
ExecStart=/usr/bin/python3 -m speedcam_v2.main --config /home/radarpi/radar/speedcam_v2/configs/live_pi_ultralytics.yaml
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

